header.page-header-mobile
  .page-header-mobile__top-row
    .page-header-mobile__top-row-inner
      +lang-selector()(class='page-header-mobile__lang-selector')
      +phone()(class='page-header-mobile__phone')
  .page-header-mobile__bottom-row
    .page-header-mobile__left-column
      +burger-button()(class='page-header-mobile__menu-button')
      each iconButton in [pageHeaderContent.iconButtons[1]]
        +icon-button(iconButton.a11y, iconButton.icon)(href=iconButton.href, bordered, badge)
    +logo()(class='page-header-mobile__logo')
    .page-header-mobile__right-column
      each iconButton, index in [pageHeaderContent.iconButtons[0], pageHeaderContent.iconButtons[2]]
        if(index === 1)
          +icon-button(iconButton.a11y, iconButton.icon)(href=iconButton.href, bordered, badge="20")
        else
          +icon-button(iconButton.a11y, iconButton.icon)(href=iconButton.href, bordered, badge)
    +search-form()(class='page-header-mobile__search-form')
  .page-header-mobile__menu.burger-menu
    .page-header-mobile__menu-headline
      button.burger-menu__content-close-button
      .page-header-mobile__menu-headline-column
        +city()
        +schedule()
      .page-header-mobile__socials.socials 
        each social in pageHeaderContent.socials
          +social-button(social.a11y, social.icon)(href=social.href)
    +wordpress-navigation-menu(menuHierarhy)(class='page-header-mobile__navigation')
    +action-button(pageHeaderContent.actionButton.label, pageHeaderContent.actionButton.icon)(href='#')
    .page-header-mobile__links
      each link in pageHeaderContent.links
        a.link(href=link.href)= link.label

header.page-header-desktop
  .page-header-desktop__top-row
    .page-header-desktop__top-row-inner
      .page-header-desktop__top-row-column
        +city()
        +phone()(class='page-header-desktop__phone')
      +schedule()
      .page-header-desktop__links
        each link in pageHeaderContent.links
          a.link(href=link.href)= link.label
  .page-header-desktop__bottom-row
    +burger-button()(class='page-header-desktop__menu-button')
    +logo()(class='page-header-desktop__logo')
    .page-header-desktop__some
      +search-form()(class='page-header-desktop__search-form')
      .page-header-desktop__socials.socials 
        each social in pageHeaderContent.socials
          +social-button(social.a11y, social.icon)(href=social.href)
      +lang-selector()(class='page-header-desktop__lang-selector')
      .page-header-desktop__icon-buttons
        each iconButton, index in pageHeaderContent.iconButtons
          if(index === (pageHeaderContent.iconButtons.length  - 1))
            +icon-button(iconButton.a11y, iconButton.icon)(href=iconButton.href, bordered, badge="20")
          else
            +icon-button(iconButton.a11y, iconButton.icon)(href=iconButton.href, bordered, badge)
    .page-header-desktop__navigation-wrapper
      +wordpress-navigation-menu(menuHierarhy)(class='page-header-desktop__navigation')
      .page-header-desktop__no-depth-navigation-viewport
      .page-header-desktop__navigation-viewport
        .left-column 
        .right-column
      .page-header-desktop__navigation-backdrop
    +action-button(pageHeaderContent.actionButton.label, pageHeaderContent.actionButton.icon)(href='#', class='page-header-desktop__action-button')
-
  const heroSectionContent = {
    title: 'Отправляйся в приключения с нашими эпическими лут-корзинами и наборами!',
    desc: 'Развивай свои навыки, следуя мудрым стратегиям мастеров, и поднимайся на новый уровень мастерства! С нашей поддержкой каждое твое действие станет частью великого искусства, а победы — результатом точного плана и безупречной подготовки!',
    button: {
      label: 'В каталог',
    },
    decorImage:  {
      media: [
        {viewport: 360, imageCount: 1, widthOffset: 0},
        {viewport: 768, imageCount: 1, widthOffset: 0},
      ],
      srcset: [
        {path: '@image/raw/common/gamepad-360.png', wDescriptor: 360},
        {path: '@image/raw/common/gamepad-768.png', wDescriptor: 768},
      ],
    },
  }

section.section.hero-section
  h2.section__title.hero-section__title= heroSectionContent.title
  p.hero-section__description= heroSectionContent.desc
  +main-button(heroSectionContent.button.label)(class='hero-section__button', neutral)
  .hero-section__decor-image-wrapper
    img.responsive-img.hero-section__decor-image(
      sizes="(min-width: 768px) 768px, (min-width: 360px) 360px, 100vw",
      alt="",
      loading="lazy",
      srcset=`${'@image/prepared/common/gamepad-360.png'} 360w, ${'@image/prepared/common/gamepad-768.png'} 768w`,
      src='@image/prepared/common/gamepad-360.png')

